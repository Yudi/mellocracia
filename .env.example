# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=https://mellocracia.yudi.me
PUBLIC_ORIGIN=https://mellocracia.yudi.me
PUBLIC_SITE_URL=https://mellocracia.yudi.me
PUBLIC_API_BASE_URL=/api
VOTE_PATH_PREFIX=/p
RESULTS_PATH_PREFIX=/r
DATA_ROOT=/home/shared/docker-data/mellocracia

# PostgreSQL 18 (use a long random password and URL-encode it in DATABASE_URL)
POSTGRES_USER=mellocracia
POSTGRES_DB=mellocracia
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mellocracia:replace-with-a-long-random-password@db:5432/mellocracia
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis 8 is private to the Compose backend network.
REDIS_URL=redis://redis:6379

# Ghost Content API. The key below is the public read-only key for mello.yudi.com.br.
GHOST_CONTENT_API_URL=https://mello.yudi.com.br/ghost/api/content
GHOST_CONTENT_API_KEY=cc080bfb3b457eb97a40a0f1bc
GHOST_API_VERSION=v6.0
GHOST_MAX_POSTS=1000
GHOST_CACHE_TTL_SECONDS=300
GHOST_FETCH_TIMEOUT_MS=10000
GHOST_FETCH_ATTEMPTS=3

# Opaque capability and privacy-preserving IP hashes use separate secrets.
TOKEN_HASH_SECRET=replace-with-at-least-32-random-bytes
IP_HASH_SECRET=replace-with-a-different-32-byte-secret

# Trust CF-Connecting-IP only when the origin is unreachable except through
# Cloudflare and the configured Traefik network.
TRUST_CLOUDFLARE=true
COOKIE_SECURE=true
VOTER_COOKIE_NAME=mellocracia_voter

# Optional Cloudflare Turnstile. Leave both values empty to disable locally.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Polls remain ephemeral and the server always caps duration at 336 hours.
POLL_MAX_OPTIONS=1000
POLL_MAX_VOTES=100000
POLL_CLEANUP_BATCH_SIZE=100

# Redis-backed fixed-window limits. Mutation routes fail closed if Redis is down.
CREATE_RATE_LIMIT_10M=3
CREATE_RATE_LIMIT_DAY=20
VOTE_RATE_LIMIT_MINUTE=10
VOTE_GLOBAL_RATE_LIMIT_MINUTE=60
READ_RATE_LIMIT_MINUTE=120
CATALOG_RATE_LIMIT_MINUTE=30
RESULTS_RATE_LIMIT_MINUTE=30
