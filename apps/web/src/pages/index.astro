---
import BaseLayout from '../layouts/BaseLayout.astro';
import Creator from '../components/Creator.svelte';

export const prerender = false;
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || undefined;
---

<BaseLayout
  title="Crie a votação"
  description="Escolha jogos do catálogo do Mello Games, compartilhe a votação e acompanhe a escolha da mesa."
  canonicalPath="/"
>
  <Creator client:load turnstileSiteKey={turnstileSiteKey} />
</BaseLayout>
