---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VotePoll from '../../components/VotePoll.svelte';

export const prerender = false;

const { token } = Astro.params;
if (!token) {
  return Astro.redirect('/');
}
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || undefined;
---

<BaseLayout
  title="Vote nos próximos jogos"
  description="Consulte os jogos escolhidos pela mesa e registre o seu voto."
  canonicalPath="/"
  socialImagePath="/og/mellocracia-vote.png"
  socialImageAlt="Mellocracia: hora de votar no próximo jogo."
>
  <VotePoll client:load token={token} turnstileSiteKey={turnstileSiteKey} />
</BaseLayout>
